  "risks": [
    {
      "id": "wide_ranges",
      "text": "The ranges are wide. The plan's range runs from a small gain to a large one, and the always-on channels' costs per deal span a wide band.",
      "facts": [
        "realloc_deals_per_year",
        "linkedin_cpa",
        "display_cpa",
        "affiliates_cpa"
      ]
    },
    {
      "id": "always_on_not_measured",
      "text": "Non-brand search, LinkedIn, display and affiliates run every week in every market and never pause, so the data never show what happens without them. Their numbers lean on the model's starting assumptions. Every cut in the plan lands on these channels.",
      "facts": [
        "realloc_cut_loss_per_year",
        "realloc_cut_levels"
      ]
    },
    {
      "id": "meta_season",
      "text": "Meta pushes into the busy seasons in every market, the same weeks fleets shop anyway, so the model cannot tell Meta's effect from the season. Meta's range runs from almost nothing to a lot, and the plan grows Meta.",
      "facts": [
        "meta_deals_per_year",
        "realloc_meta_change_pct"
      ]
    },
    {
      "id": "paid_under_credited",
      "text": "Paid media is likely under-credited. On simulated worlds with a known answer, this kind of model gave always-on channels too little credit until a test anchored them. If so, the cuts cost more than shown, and the plan's gain is smaller.",
      "facts": [
        "paid_share_of_deals"
      ]
    },
    {
      "id": "fit_is_not_proof",
      "text": "The model predicts weekly deals well on weeks it never saw, but a model can predict the total well and still split it wrongly between channels.",
      "facts": [
        "holdout_weeks",
        "holdout_weekly_error"
      ]
    },
    {
      "id": "youtube_ask_scale",
      "text": "The YouTube ask rests on YouTube's on and off flights, the best measured channel. Each step up buys fewer deals than the last, and the model has not seen YouTube much past the size of the ask.",
      "facts": [
        "ask_step1_cost_per_deal",
        "ask_step2_cost_per_deal"
      ]
    }
  ],
  "test": {
    "what": "Run the plan's cuts to LinkedIn, display and affiliates in a few markets first, against matched markets at today's spend. It costs no new budget and spends a little less.",
    "decision_rule": "If deals in the test markets fall about as much as the model expects, make the full reallocation. If they fall clearly more, the model is giving these channels too little credit: stop the cuts and refit the model with the test as a lift test.",
    "limits": "The test can catch a large miss, not a small one.",
    "facts": [
      "test_markets",
      "test_control_markets",
      "test_weeks",
      "test_weeks_range",
      "realloc_cut_levels",
      "test_spend_held_back",
      "test_market_deals",
      "test_expected_drop",
      "test_expected_drop_pct",
      "test_detectable_drop",
      "test_detectable_multiple"
    ]
  },
