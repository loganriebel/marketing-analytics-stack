<?xml version='1.0'?>
<workbook>
  <preferences>
    <!-- Marketing roles, in this order: performance, brand, events, owned, unpaid. -->
    <color-palette name="Fernhook roles" type="regular">
      <color>#0072B2</color>
      <color>#C27800</color>
      <color>#CC6A8E</color>
      <color>#1B7A55</color>
      <color>#878D89</color>
    </color-palette>
    <!-- Dashboard 2 views: CRM last touch, platform reported, MMM, answer key. -->
    <color-palette name="Fernhook views" type="regular">
      <color>#6E7470</color>
      <color>#CC6A8E</color>
      <color>#1B7A55</color>
      <color>#000000</color>
    </color-palette>
    <!-- Test or rollout markets first, then control or holdout. -->
    <color-palette name="Fernhook test vs control" type="regular">
      <color>#0072B2</color>
      <color>#878D89</color>
    </color-palette>
    <color-palette name="Fernhook blue" type="ordered-sequential">
      <color>#93BADF</color>
      <color>#6A9FD0</color>
      <color>#3F86C1</color>
      <color>#0072B2</color>
      <color>#0B4F80</color>
    </color-palette>
    <color-palette name="Fernhook red-blue" type="ordered-diverging">
      <color>#C8452F</color>
      <color>#DC8873</color>
      <color>#EEC5B9</color>
      <color>#EDECE6</color>
      <color>#B4CFE8</color>
      <color>#6A9FD0</color>
      <color>#0072B2</color>
    </color-palette>
  </preferences>
</workbook>
